# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
# Ignorar dist/ mas incluir dist/web (bundle web) e dist/index.js (servidor)
# Nota: em Git, para exceções funcionarem dentro de um diretório ignorado,
# o diretório pai não pode ser ignorado com trailing slash.
# Por isso ignoramos apenas os subdiretórios não desejados:
dist/web-build/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

